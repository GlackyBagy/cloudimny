{
	# Clients connecting to a bare IP (the normal case here) don't send SNI.
	# Without this, Caddy has no certificate to offer them at all and the
	# TLS handshake fails with a TLS internal_error, even with only one site
	# bound to :443 below. Must be a top-level global option (not nested
	# under "servers"), and this block must come first in the file.
	default_sni {$CADDY_ADDRESS}
}

{$CADDY_ADDRESS} {
	# Self-signed cert generated by setup-script.bash (openssl req -x509),
	# not an ACME/Let's Encrypt cert — there's no public domain to validate
	# against for an arbitrary self-hosted IP/hostname, so Caddy's normal
	# automatic-HTTPS flow doesn't apply here; we hand it the files directly.
	#
	# This must stay the ONLY site bound to :443 — a second competing site
	# on the same port would make Caddy require SNI to disambiguate between
	# them, defeating the default_sni fallback above.
	tls /etc/ssl/cloudimny/server.crt /etc/ssl/cloudimny/server.key
	reverse_proxy api:8080
}
