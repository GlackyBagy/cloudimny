<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Базовая тема приложения. Общая для дневного и ночного режимов:
        палитра пока одна. Для отдельной тёмной палитры достаточно создать
        values-night/colors.xml — родитель DayNight подхватит его сам,
        дублировать саму тему в values-night не нужно.
    -->
    <style name="Base.Theme.Cloudimny" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Fonts -->
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>

        <!-- Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:textColorPrimary">?attr/colorOnBackground</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>

        <!-- Widget defaults -->
        <item name="materialButtonStyle">@style/Widget.Cloudimny.Button</item>
    </style>

    <style name="Theme.Cloudimny" parent="Base.Theme.Cloudimny" />
</resources>
