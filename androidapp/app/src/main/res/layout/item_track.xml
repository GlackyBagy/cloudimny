<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Cloudimny.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/track_cover"
        style="@style/Widget.Cloudimny.Cover"
        android:layout_width="@dimen/row_cover_size"
        android:layout_height="@dimen/row_cover_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/track_title"
        style="@style/Widget.Cloudimny.Text.RowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/row_cover_gap"
        app:layout_constraintBottom_toTopOf="@id/track_artist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/track_cover"
        app:layout_constraintTop_toTopOf="@id/track_cover"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Track title" />

    <TextView
        android:id="@+id/track_artist"
        style="@style/Widget.Cloudimny.Text.RowSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/row_cover_gap"
        app:layout_constraintBottom_toBottomOf="@id/track_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/track_cover"
        app:layout_constraintTop_toBottomOf="@id/track_title"
        tools:text="Artist name" />

</androidx.constraintlayout.widget.ConstraintLayout>
