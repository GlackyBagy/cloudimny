<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Cloudimny.Text.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/all_tracks" />

                <ImageButton
                    android:id="@+id/all_tracks_arrow"
                    style="@style/Widget.Cloudimny.IconButton.Filled"
                    android:layout_width="@dimen/icon_button_size_small"
                    android:layout_height="@dimen/icon_button_size_small"
                    android:contentDescription="@string/cd_see_all_tracks"
                    android:padding="@dimen/space_s"
                    android:src="@drawable/arrow_forward_icon"
                    app:tint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tracks_preview_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/list_padding_horizontal"
                tools:listitem="@layout/item_track" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Cloudimny.Text.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/all_playlists" />

                <ImageButton
                    android:id="@+id/all_playlists_arrow"
                    style="@style/Widget.Cloudimny.IconButton.Filled"
                    android:layout_width="@dimen/icon_button_size_small"
                    android:layout_height="@dimen/icon_button_size_small"
                    android:contentDescription="@string/cd_see_all_playlists"
                    android:padding="@dimen/space_s"
                    android:src="@drawable/arrow_forward_icon"
                    app:tint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlists_preview_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/list_padding_horizontal"
                tools:listitem="@layout/item_playlist" />

            <TextView
                android:id="@+id/no_playlists_label"
                style="@style/Widget.Cloudimny.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/no_playlists_yet"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
