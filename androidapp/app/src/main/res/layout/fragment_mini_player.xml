<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginTop="@dimen/space_s"
    android:layout_marginBottom="10dp"
    android:background="@drawable/mini_player_background"
    android:elevation="@dimen/elevation_raised"
    android:paddingHorizontal="10dp"
    android:paddingVertical="@dimen/space_s"
    tools:context=".views.MiniPlayerFragment">

    <ImageView
        android:id="@+id/track_cover"
        style="@style/Widget.Cloudimny.Cover"
        android:layout_width="@dimen/mini_player_cover_size"
        android:layout_height="@dimen/mini_player_cover_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/track_title"
        style="@style/Widget.Cloudimny.Text.RowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/track_artist"
        app:layout_constraintEnd_toStartOf="@id/play_button"
        app:layout_constraintStart_toEndOf="@id/track_cover"
        app:layout_constraintTop_toTopOf="@id/track_cover"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Track title" />

    <TextView
        android:id="@+id/track_artist"
        style="@style/Widget.Cloudimny.Text.RowSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="@dimen/text_caption"
        app:layout_constraintBottom_toBottomOf="@id/track_cover"
        app:layout_constraintEnd_toStartOf="@id/play_button"
        app:layout_constraintStart_toEndOf="@id/track_cover"
        app:layout_constraintTop_toBottomOf="@id/track_title"
        tools:text="Artist name" />

    <ImageButton
        android:id="@+id/play_button"
        style="@style/Widget.Cloudimny.IconButton"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:contentDescription="@string/cd_play_pause"
        android:padding="@dimen/space_s"
        android:src="@drawable/play_arrow_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorPrimary" />

</androidx.constraintlayout.widget.ConstraintLayout>
