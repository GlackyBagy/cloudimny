<?xml version="1.0" encoding="utf-8"?>
<!--
    server_data holds the server's auth secret — a bearer token good for full API access — and the
    pinned certificate fingerprint. Backing it up would let it leak through a compromised Google
    account or land it on a device it was never meant for; every other preferences file is fine to
    carry over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="server_data.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="server_data.xml" />
    </device-transfer>
</data-extraction-rules>
