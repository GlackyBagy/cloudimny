<?xml version="1.0" encoding="utf-8"?>
<!--
    Applies below Android 12, where data_extraction_rules.xml is ignored. Same reasoning: the auth
    secret and pinned fingerprint in server_data must not leave the device via Auto Backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="server_data.xml" />
</full-backup-content>
